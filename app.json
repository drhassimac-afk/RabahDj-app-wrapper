{
  "expo": {
    "name": "RabahDj-app-wrapper",
    "slug": "RabahDj-app-wrapper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rabahdjappwrapper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "التطبيق يحتاج الكاميرا للبث المباشر",
        "NSMicrophoneUsageDescription": "التطبيق يحتاج المايك للتخاطب الصوتي والبث"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "package": "com.drhassimac.rabahdjappwrapper"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b49a8cee-2396-4d27-9cd5-025a37f7e840"
      }
    },
    "owner": "rabahdfd"
  }
}